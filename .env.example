DEBUG=true
ADDR=127.0.0.1:8081

# Container gateway; false only behind a trusted TLS proxy that replaces client headers.
ANUBIS_DIFFICULTY=4
ANUBIS_BIND=0.0.0.0:8080
# Empty selects forwarded client IP on Railway, socket IP elsewhere.
ANUBIS_USE_REMOTE_ADDRESS=

DB_PATH=data/shareserver.db
BLOB_DIR=data/blobs

# Optional override; production otherwise persists a generated key beside DB_PATH.
APP_SECRET=

# ADMIN_USER=
# ADMIN_PASSWORD=

MAX_UPLOAD_BYTES=314572800
STORAGE_CAP_BYTES=419430400
TRUST_PROXY_HEADERS=true

TZ=Asia/Shanghai
